# /etc/ds41/r21.env, read by ds41-start-r21.sh: the served r21 configuration.
: "${SPEC_TOKENS:=5}"
: "${KV_DTYPE:=fp8_ds_mla}"
: "${INDEXER_KV_DTYPE:=fp8}"
: "${MNS:=8}"
: "${MNBT:=8192}"
: "${CG:=128}"
: "${OFFLOAD_GIB:=0}"
: "${EFFORT:=max}"
# FLy verification at window 1 plus top_p 1.0: measured +22% mean single-stream on the coding-agent
# workload (per-task range +18 to +28%, at 30k and 120k alike), accepted length 3.4 -> 4.24, GSM8K-100
# unchanged at 96% (work/RESULTS.md). FLy is a lossy sampler and its window is the lever (vLLM's default
# min(6,k-1)=4 lets only draft position 0 defer and measured -2%); top_p 1.0 removes the p-truncated /
# q-untruncated mismatch in the verifier.
: "${TOPP:=1.0}"
: "${REJ:=fly}"
: "${FLY_WIN:=1}"
# VLLM_MOET_DET_TOPK is a launcher knob (ds41-start-r21.sh), default 1 since round 68: the deterministic
# indexer top-k kernel replaces persistent_topk (45.6 us x 8 layers = 0.36 ms/step at 120k) and measures
# -4.2 % step at 120k, neutral at 30k, GSM8K-100 97/100. Set DET_TOPK=0 to restore the upstream kernel.
