# cp .env.example .env, then fill in the two secrets. .env is in .gitignore.
# Everything else defaults to the values in config.sh. Uncomment a line only to change it.

# Secrets
DS41_API_KEY=          # Bearer key checked by Caddy and vLLM. New key: echo "sk-ds41-$(openssl rand -hex 24)"
HF_TOKEN=              # optional; the model repo is public and the 510 GB download works without it

# PROJECT=PROJECT                       # default: gcloud config get-value project
# VM_NAME=VM_NAME                       # the serving VM; set it to the name gcp/flex.sh prints
# PROVISIONING=FLEX_START               # SPOT or STANDARD use gcp/grab.sh
# ZONES="ZONE"                          # overrides FLEX_ZONES / SPOT_ZONES / STANDARD_ZONES
# BOOT_SNAPSHOT=                        # Flex-start boot disk from a snapshot of a prepared VM
# STATIC_IP_NAME=dsv41-ip
# FIREWALL_RULE=allow-dsv41-https
# NETWORK_TAG=dsv41-https
# ENGINE=r21                            # r21 (vLLM-Moet r21) or lil (Local Inference Lab vLLM)
# MODEL_REPO=mrfakename/DeepSeek-V4.1-Flash-1017-abliterated
# MODEL_REV=517efab9ccfef7f714dbd7d679f181a86f43ccf9
# DOMAIN=                               # empty: <static-ip>.sslip.io
# ACME_EMAIL=
