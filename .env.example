# cp .env.example .env, then fill in the two secrets. .env is in .gitignore.
# Everything else defaults to the values in config.sh, which reproduce the deployment of
# 2026-10-22. Uncomment a line only to change it.

# Secrets
DS41_API_KEY=          # Bearer key checked by Caddy and vLLM. New key: echo "sk-ds41-$(openssl rand -hex 24)"
HF_TOKEN=              # optional; the model repo is public and the 510 GB download works without it

# PROJECT=jinaai-dev
# VM_NAME=ds41-flash-rtx-spot
# PROVISIONING=SPOT                     # STANDARD for on-demand
# ZONES="us-west3-a"                    # overrides SPOT_ZONES / STANDARD_ZONES
# MODEL_REPO=mrfakename/DeepSeek-V4.1-Flash-1017-abliterated
# MODEL_REV=517efab9ccfef7f714dbd7d679f181a86f43ccf9
# DOMAIN=                               # empty: <static-ip>.sslip.io
# ACME_EMAIL=
